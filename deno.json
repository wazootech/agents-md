{
  "imports": { "@std/assert": "jsr:@std/assert@1" },
  "tasks": {
    "test": "deno test",
    "check": "deno check src/ scripts/ test/",
    "build": "deno run -A scripts/build.ts",
    "dev": "deno task build && deno run --allow-net --allow-read jsr:@std/http/file-server dist"
  },
  "fmt": { "exclude": ["dist"] },
  "lint": { "exclude": ["dist"] },
  "compilerOptions": { "strict": true }
}
